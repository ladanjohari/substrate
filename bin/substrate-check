#!/usr/bin/env python3
"""
Run every substrate command against a throwaway database and fail loudly.

This exists because `substrate` on its own was broken in public for three
days. The change that broke it was tested by running the commands the change
was about, which is not the same as running the commands that still have to
work.

No AI calls, no network, no writing to your real database. It makes a
temporary file, exercises every command, deletes it, and prints one line.

    ./bin/substrate-check          run it
    echo $?                        0 if everything ran, 1 if anything crashed
"""

import os
import subprocess
import sys
import tempfile
from pathlib import Path

CLI = Path(__file__).resolve().parent / "substrate"

# Every command form a person can type. Each entry is the arguments and what
# the run is expected to do: "ok" means it must succeed, "refuse" means it
# must stop with a message rather than a crash.
CASES = [
    ([], "ok"),
    (["tree"], "ok"),
    (["tree", "trip"], "ok"),
    (["frontier"], "ok"),
    (["path"], "ok"),
    (["show", "flights"], "ok"),
    (["criteria", "flights"], "ok"),
    (["log"], "ok"),
    (["log", "3"], "ok"),
    (["--help"], "ok"),
    (["--json", "tree"], "ok"),
    (["state", "trip", "done"], "refuse"),        # criteria still open
    (["meet", "2"], "refuse"),                    # no evidence
    (["approve", "trip"], "refuse"),              # not a proposed plan
    (["reject", "trip"], "refuse"),               # not a proposed plan
    (["changes", "trip", "fewer", "tasks"], "refuse"),  # not a proposed plan
    (["meet", "2", "-e", "both legs are booked"], "ok"),
    (["reopen", "2"], "ok"),
    (["fail", "2", "-e", "the fare went up"], "ok"),
    (["add-criterion", "flights", "a seat is chosen"], "ok"),
    (["edit", "flights", "-t", "Book the flights"], "ok"),
    (["block", "hotel", "--after", "flights"], "ok"),
    (["unblock", "hotel", "--from", "flights"], "ok"),
    (["remove", "hotel"], "ok"),
]

SETUP = [
    ["add", "trip", "Plan a trip", "-c", "Flights are booked"],
    ["add", "trip/flights", "Book flights", "-c", "Both legs", "-c", "Under 600"],
    ["add", "trip/hotel", "Book a hotel", "-c", "Free cancellation", "--after", "flights"],
]

CRASHES = ("Traceback", "NameError", "AttributeError", "TypeError:",
           "KeyError", "IndentationError", "sqlite3.")


def check_internal_callers():
    """One command calling another must hand it arguments it can use.

    `decompose` ends by drawing the tree, with its own parsed arguments, which
    do not carry the tree command's flags. Reaching for one of those directly
    crashed a command that had just spent half a minute working. There are no
    AI calls here, so this is the one thing the run below cannot exercise.
    """
    import ast
    src = (CLI.resolve().parent.parent / "store" / "substrate_cli.py").read_text()
    tree = ast.parse(src)
    funcs = {n.name: n for n in ast.walk(tree)
             if isinstance(n, ast.FunctionDef) and n.name.startswith("cmd_")}

    # What each subcommand actually puts on the namespace, and what the top
    # level puts on every namespace.
    def arg_name(call):
        for a in call.args:
            if isinstance(a, ast.Constant) and isinstance(a.value, str):
                if a.value.startswith("--"):
                    return a.value[2:].replace("-", "_")
                if not a.value.startswith("-"):
                    return a.value.replace("-", "_")
        return None

    defined, always = {}, {"cmd", "json"}
    current = None
    for node in ast.walk(funcs.get("main") or tree):
        pass
    main_fn = next((n for n in ast.walk(tree)
                    if isinstance(n, ast.FunctionDef) and n.name == "main"), None)
    if main_fn:
        for node in ast.walk(main_fn):
            if not isinstance(node, ast.Call):
                continue
            fn = node.func
            if not isinstance(fn, ast.Attribute):
                continue
            if fn.attr == "add_parser" and node.args:
                first = node.args[0]
                if isinstance(first, ast.Constant):
                    current = first.value
                    defined.setdefault(current, set())
            elif fn.attr == "add_argument":
                name = arg_name(node)
                if not name:
                    continue
                if getattr(fn.value, "id", None) == "p":
                    always.add(name)      # on the top level: always present
                elif current:
                    defined[current].add(name)

    problems = []
    for name, fn in funcs.items():
        caller_cmd = name[len("cmd_"):].replace("_", "-")
        has = always | defined.get(caller_cmd, set()) | defined.get(name[4:], set())
        # Anything the caller assigns itself before handing the namespace over
        # is present too.
        for node in ast.walk(fn):
            if isinstance(node, ast.Assign):
                for t in node.targets:
                    if isinstance(t, ast.Attribute) and getattr(t.value, "id", None) == "a":
                        has.add(t.attr)
        for call in (n for n in ast.walk(fn) if isinstance(n, ast.Call)):
            callee = getattr(call.func, "id", None)
            if callee not in funcs or callee == name:
                continue
            for attr in (n for n in ast.walk(funcs[callee])
                         if isinstance(n, ast.Attribute)
                         and getattr(n.value, "id", None) == "a"):
                if attr.attr in has:
                    continue
                problems.append(
                    f"{name} hands its arguments to {callee}, which reads "
                    f"a.{attr.attr}. {caller_cmd} does not define it, so that "
                    f"crashes. Use getattr(a, \"{attr.attr}\", <default>).")
    return sorted(set(problems))


def run(args, env):
    p = subprocess.run([str(CLI)] + args, capture_output=True, text=True, env=env)
    return p.returncode, (p.stdout + p.stderr)


def main():
    crossed = check_internal_callers()
    if crossed:
        for line in crossed:
            print("FAILED  " + line)
        print(f"{len(crossed)} command(s) hand arguments to a command that cannot take them")
        return 1

    tmp = tempfile.mkdtemp(prefix="substrate-check-")
    env = {**os.environ, "SUBSTRATE_DB": str(Path(tmp) / "check.db"),
           "NO_COLOR": "1", "SUBSTRATE_ACTOR": "check"}
    failures = []

    for args in SETUP:
        code, out = run(args, env)
        if code != 0:
            failures.append(("setup " + " ".join(args), out.strip()[-300:]))

    for args, expect in CASES:
        code, out = run(args, env)
        name = "substrate " + " ".join(args)
        crashed = any(m in out for m in CRASHES)
        if crashed:
            failures.append((name, "crashed:\n" + out.strip()[-400:]))
        elif expect == "ok" and code != 0:
            failures.append((name, f"should have worked, exited {code}:\n"
                                   + out.strip()[-300:]))
        elif expect == "refuse" and code == 0:
            failures.append((name, "should have been refused, but it went through"))

    for f in Path(tmp).glob("*"):
        f.unlink()
    Path(tmp).rmdir()

    if failures:
        for name, why in failures:
            print(f"FAILED  {name}\n        {why}\n")
        print(f"{len(failures)} of {len(CASES)} command forms are broken")
        return 1
    print(f"all {len(CASES)} command forms ran as expected")
    return 0


if __name__ == "__main__":
    sys.exit(main())

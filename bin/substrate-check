#!/usr/bin/env python3
"""
Run every substrate command against a throwaway database and fail loudly.

This exists because `substrate` on its own was broken in public for three
days. The change that broke it was tested by running the commands the change
was about, which is not the same as running the commands that still have to
work.

No AI calls, no network, no writing to your real database. It makes a
temporary file, exercises every command, deletes it, and prints one line.

    ./bin/substrate-check          run it
    echo $?                        0 if everything ran, 1 if anything crashed
"""

import os
import subprocess
import sys
import tempfile
from pathlib import Path

CLI = Path(__file__).resolve().parent / "substrate"

# Every command form a person can type. Each entry is the arguments and what
# the run is expected to do: "ok" means it must succeed, "refuse" means it
# must stop with a message rather than a crash.
CASES = [
    ([], "ok"),
    (["tree"], "ok"),
    (["tree", "trip"], "ok"),
    (["frontier"], "ok"),
    (["path"], "ok"),
    (["show", "flights"], "ok"),
    (["criteria", "flights"], "ok"),
    (["log"], "ok"),
    (["log", "3"], "ok"),
    (["--help"], "ok"),
    (["--json", "tree"], "ok"),
    (["state", "trip", "done"], "refuse"),        # criteria still open
    (["meet", "2"], "refuse"),                    # no evidence
    (["approve", "trip"], "refuse"),              # not a proposed plan
    (["reject", "trip"], "refuse"),               # not a proposed plan
    (["changes", "trip", "fewer", "tasks"], "refuse"),  # not a proposed plan
    (["meet", "2", "-e", "both legs are booked"], "ok"),
    (["reopen", "2"], "ok"),
    (["fail", "2", "-e", "the fare went up"], "ok"),
    (["add-criterion", "flights", "a seat is chosen"], "ok"),
    (["edit", "flights", "-t", "Book the flights"], "ok"),
    (["block", "hotel", "--after", "flights"], "ok"),
    (["unblock", "hotel", "--from", "flights"], "ok"),
    (["remove", "hotel"], "ok"),
]

SETUP = [
    ["add", "trip", "Plan a trip", "-c", "Flights are booked"],
    ["add", "trip/flights", "Book flights", "-c", "Both legs", "-c", "Under 600"],
    ["add", "trip/hotel", "Book a hotel", "-c", "Free cancellation", "--after", "flights"],
]

CRASHES = ("Traceback", "NameError", "AttributeError", "TypeError:",
           "KeyError", "IndentationError", "sqlite3.")


def run(args, env):
    p = subprocess.run([str(CLI)] + args, capture_output=True, text=True, env=env)
    return p.returncode, (p.stdout + p.stderr)


def main():
    tmp = tempfile.mkdtemp(prefix="substrate-check-")
    env = {**os.environ, "SUBSTRATE_DB": str(Path(tmp) / "check.db"),
           "NO_COLOR": "1", "SUBSTRATE_ACTOR": "check"}
    failures = []

    for args in SETUP:
        code, out = run(args, env)
        if code != 0:
            failures.append(("setup " + " ".join(args), out.strip()[-300:]))

    for args, expect in CASES:
        code, out = run(args, env)
        name = "substrate " + " ".join(args)
        crashed = any(m in out for m in CRASHES)
        if crashed:
            failures.append((name, "crashed:\n" + out.strip()[-400:]))
        elif expect == "ok" and code != 0:
            failures.append((name, f"should have worked, exited {code}:\n"
                                   + out.strip()[-300:]))
        elif expect == "refuse" and code == 0:
            failures.append((name, "should have been refused, but it went through"))

    for f in Path(tmp).glob("*"):
        f.unlink()
    Path(tmp).rmdir()

    if failures:
        for name, why in failures:
            print(f"FAILED  {name}\n        {why}\n")
        print(f"{len(failures)} of {len(CASES)} command forms are broken")
        return 1
    print(f"all {len(CASES)} command forms ran as expected")
    return 0


if __name__ == "__main__":
    sys.exit(main())
